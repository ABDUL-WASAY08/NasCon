<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ uses the platform splash-screen API instead of
         android:windowBackground. Keep it on-brand (deep black + gold emblem)
         so the native launch frame flows into the animated Flutter splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>
</resources>
