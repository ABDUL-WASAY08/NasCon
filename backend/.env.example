NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

# Use a MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/nascon?retryWrites=true&w=majority

# Google OAuth Web client ID. Configure all Flutter platform client IDs as appropriate.
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Cloudinary credentials. Never include these in Flutter or a public repository.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Comma-separated origins; include your Flutter web dev origin when applicable.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
